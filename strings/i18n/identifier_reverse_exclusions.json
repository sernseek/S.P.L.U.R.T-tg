		"CAST(COALESCE(SUM(CASE WHEN t.action = 'Resolved' THEN 1 ELSE 0 END), 0) AS UNSIGNED) AS Resolved_count, ": "identifier",
		"CAST(COALESCE(SUM(CASE WHEN t.action IN ('Rejected', 'Resolved', 'Closed', 'IC Issue') THEN 1 ELSE 0 END), 0) AS UNSIGNED) AS Total_tickets, ": "identifier",
