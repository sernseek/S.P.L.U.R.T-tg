	"_comment": "These newly translated English strings also occur as DM identifiers. Keep their keyed translations, but exclude the source from context-free global reverse lookup.",
	"zh-Hans": {
		" GROUP BY a.ckey, a.rank ORDER BY a.ckey ASC": "identifier",
